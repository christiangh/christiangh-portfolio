---
import "../styles/global.css";
import CghHeader from '../components/CghHeader.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Christian García Herreras - Desarrollador frontend - { title }</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&family=Shrikhand&display=swap" rel="stylesheet">
	</head>
	<body class="grid place-content-center p-20">
		<CghHeader />

		<main class="container">
			<slot />
		</div>
	</body>
</html>

<style>
	html {
		font-family: var(--default-font-family);
		background: var(--color-beige);
		color: var(--color-dusk);
	}
</style>
