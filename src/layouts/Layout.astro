---
import "../styles/global.css";
import CghHeader from "../components/CghHeader.astro";
import ScrollSpy from "../components/ScrollSpy.astro";
import CursorAnimation from "../components/CursorAnimation.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F4B22E" />
    <meta name="generator" content={Astro.generator} />
    <title>Christian García - Desarrollador frontend - {title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <div class="mx-auto flex max-w-screen-xl">
      <header class="sticky top-0 h-screen w-[375px] px-12 py-10">
        <CghHeader />
      </header>

      <main class="flex-1 px-12 py-10">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  html {
    font-family: var(--default-font-family);
    color: var(--color-dusk);
  }

  body {
    background-color: var(--color-custard-cgh);
    position: relative;
    z-index: 0;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("/psycho-waves.png");
    background-size: 120%;
    background-repeat: no-repeat;
    background-position: var(--bg-offset, center);
    opacity: 0.5;
    z-index: -1;
    pointer-events: none;
    transition: background-position 0.1s ease-out;
  }
</style>

<ScrollSpy />
<CursorAnimation />
