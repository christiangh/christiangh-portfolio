---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const mainSections = await getCollection("main-sections");
const sortedMainSections = mainSections.sort(
  (a, b) => a.data.order - b.data.order,
);

const renderedSections = await Promise.all(
  sortedMainSections.map(async (entry) => {
    const { Content } = await entry.render();
    return {
      id: entry.data.id,
      title: entry.data.title,
      Content,
    };
  }),
);
---

<Layout>
  {
    renderedSections.map(({ id, title, Content }) => (
      <section id={id} class="mb-16">
        <h2 class="font-funky text-funky mb-4 text-3xl">{title}</h2>
        <div class="prose">
          <Content />
        </div>
      </section>
    ))
  }
</Layout>
