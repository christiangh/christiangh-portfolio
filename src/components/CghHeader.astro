---
import Logo from "./Logo.astro";
---

<section class="mb-8 grid place-items-center gap-4 px-10">
  <Logo />

  <nav class="grid w-full place-items-start gap-4 text-xl sm:grid-rows-5">
    <a
      href="#about-me"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-coral-cgh h-1 w-6 rounded transition-all duration-300 group-hover:w-12"
      ></span>
      <span>Sobre mí</span>
    </a>
    <a
      href="#professional-experience"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-mustard-cgh h-1 w-6 rounded transition-all duration-300 group-hover:w-12"
      ></span>
      <span>Experiencia laboral</span>
    </a>
    <a
      href="#education"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-chocolate-cgh h-1 w-6 rounded transition-all duration-300 group-hover:w-12"
      ></span>
      <span>Formación</span>
    </a>
    <a
      href="#projects"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-mustard-cgh h-1 w-6 rounded transition-all duration-300 group-hover:w-12"
      ></span>
      <span>Proyectos</span>
    </a>
    <a
      href="#contact"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-coral-cgh h-1 w-6 rounded transition-all duration-300 group-hover:w-12"
      ></span>
      <span>Contacto</span>
    </a>
  </nav>
</section>

