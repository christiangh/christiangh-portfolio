---
import Logo from "./Logo.astro";
---

<section class="flex h-full flex-col items-center justify-between">
  <Logo />

  <nav class="grid w-full place-items-start gap-4 text-xl sm:grid-rows-5">
    <a
      href="#aboutMe"
      class="group font-funky active inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-espresso-cgh h-1 w-6 rounded duration-300 group-hover:w-12"
      ></span>
      <span class="link-text text-tangerine-cgh">Sobre mí</span>
    </a>
    <a
      href="#professionalExperience"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-marigold-cgh h-1 w-6 rounded duration-300 group-hover:w-12"
      ></span>
      <span class="link-text text-tangerine-cgh">Experiencia laboral</span>
    </a>
    <a
      href="#education"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-espresso-cgh h-1 w-6 rounded duration-300 group-hover:w-12"
      ></span>
      <span class="link-text text-tangerine-cgh">Formación</span>
    </a>
    <a
      href="#projects"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-marigold-cgh h-1 w-6 rounded duration-300 group-hover:w-12"
      ></span>
      <span class="link-text text-tangerine-cgh">Proyectos</span>
    </a>
    <a
      href="#contact"
      class="group font-funky inline-flex items-center gap-2 text-inherit"
    >
      <span
        class="link-bar bg-espresso-cgh h-1 w-6 rounded duration-300 group-hover:w-12"
      ></span>
      <span class="link-text text-tangerine-cgh">Contacto</span>
    </a>
  </nav>
</section>

<style></style>
