<script>
  const setActive = (link: Element) => {
    document.querySelectorAll("nav a.active").forEach((el) => {
      el.classList.remove("active");
      el.removeAttribute("aria-current");
    });
    link.classList.add("active");
    link.setAttribute("aria-current", "page");
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.id;
        const link = document.querySelector(`nav a[href="#${id}"]`);
        if (entry.isIntersecting && link) setActive(link);
      });
    },
    {
      rootMargin: "0px 0px -60% 0px",
      threshold: 0.2,
    },
  );

  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll("section[id]")
      .forEach((section) => observer.observe(section));

    document
      .querySelectorAll('nav a[href^="#"]')
      .forEach((link) => link.addEventListener("click", () => setActive(link)));
  });
</script>
