---
/**
 * Christian García — 70's bubble wordmark
 *
 * Shadow finish (layered offset shadow).
 *
 * Optional props:
 *   firstLine / secondLine / tagline   → override the copy
 *   scale (number, default 1)          → resize the whole lockup
 *
 * Fonts: loads Bagel Fat One + Fredoka from Google Fonts below. If you already
 * load these in your main layout's <head>, you can delete the <link> tags here.
 */
interface Props {
  firstLine?: string;
  secondLine?: string;
  tagline?: string;
  scale?: number;
}

const {
  firstLine = "Christian",
  secondLine = "García",
  tagline = "Desarrollador · Frontend",
  scale = 1,
} = Astro.props;

const lines = [firstLine, secondLine];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Fredoka:wght@500;600;700&display=swap"
  rel="stylesheet"
/>

<div class="cg-logo" style={`--cg-scale:${scale}`}>
  <div class="cg-logo__name">
    {lines.map((word) => (
      <div>{word}</div>
    ))}
  </div>

  <div class="cg-logo__tag">{tagline}</div>
</div>

<style>
  .cg-logo {
    --cg-scale: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    font-size: calc(1rem * var(--cg-scale));
  }

  .cg-logo__name {
    font-family: "Bagel Fat One", cursive;
    text-align: center;
    transform: skewX(-4deg);
    line-height: 0.82;
    letter-spacing: -1px;
    color: #f4b22e;
    text-shadow:
      2px 2px 0 #f2882b,
      4px 4px 0 #e0431d,
      6px 6px 0 #a8331a,
      8px 9px 0 #3a1f0e;
  }
  .cg-logo__name > div {
    font-size: calc(60em / 16);
  }
  .cg-logo__name > div + div {
    margin-top: calc(2em / 16);
  }

  /* ---------- tagline ---------- */
  .cg-logo__tag {
    font-family: "Fredoka", sans-serif;
    font-weight: 600;
    font-size: calc(15em / 16);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #a8331a;
    margin-top: calc(32em / 16);
    text-align: center;
  }
</style>
